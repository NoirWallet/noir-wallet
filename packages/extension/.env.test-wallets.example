# Copy this file to .env.test-wallets.local and run: chmod 600 .env.test-wallets.local
# Store only absolute paths and non-secret metadata here. Never put a mnemonic, password,
# private key, or broadcast-enabling flag directly in this file.

# JSON: {"schemaVersion":1,"network":"sepolia","address":"0x...","mnemonic":"...","password":"..."}
# The referenced JSON file must be outside Git tracking and use mode 0600.
NOIR_EVM_TESTNET_WALLET_FILE=

# JSON: {"schemaVersion":1,"network":"bitcoin-testnet3","address":"tb1q...","mnemonic":"...","password":"8-64 characters"}
# The referenced JSON file must be outside Git tracking and use mode 0600.
NOIR_BITCOIN_TESTNET_WALLET_FILE=

# JSON: {"schemaVersion":1,"networks":["solana-devnet","near-testnet"],"solanaAddress":"...","solanaRecipientAddress":"...","nearAccountId":"...","mnemonic":"...","password":"8-64 characters"}
# The referenced JSON file must be outside Git tracking and use mode 0600.
NOIR_SOLANA_NEAR_TESTNET_WALLET_FILE=

# Optional one-off Zcash source override. Otherwise the selected TESTNET_n file is used.
NOIR_TESTNET_MNEMONIC_FILE=
NOIR_TESTNET_ACCOUNT=1
NOIR_TESTNET_BIRTHDAY_HEIGHT=
NOIR_TESTNET_SEND_AMOUNT=0.0001
NOIR_TESTNET_SEED_AMOUNT=0.001

# Reusable Zcash Testnet wallet slots. Each file contains exactly one 24-word mnemonic,
# has an absolute path, is outside Git tracking, and uses mode 0600.
TESTNET_1_MNEMONIC_FILE=
TESTNET_1_BLOCK=
TESTNET_2_MNEMONIC_FILE=
TESTNET_2_BLOCK=
