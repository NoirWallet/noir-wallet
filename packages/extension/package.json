{
  "name": "@noir-wallet/extension",
  "version": "1.0.38",
  "description": "Noir Wallet is a self-custodial crypto wallet designed to support privacy-preserving on-chain activity.",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:extension": "pnpm run dev",
    "build": "tsc --noEmit && vite build",
    "build:testnet": "tsc --noEmit && NETWORK_MODE=testnet vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/run-core-tests.mjs",
    "icons:from-logo": "node scripts/generate-icons-from-logo.mjs"
  },
  "dependencies": {
    "@iconify/react": "6.0.2",
    "@keystonehq/bc-ur-registry-zcash": "0.1.2",
    "@ledgerhq/device-management-kit": "1.8.0",
    "@ledgerhq/device-signer-kit-zcash": "0.7.0",
    "@ledgerhq/device-transport-kit-web-ble": "1.3.2",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@ngraveio/bc-ur": "1.1.13",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@rhea-finance/cross-chain-sdk": "0.1.21",
    "@scure/bip39": "1.6.0",
    "big.js": "7.0.1",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "jsqr": "1.4.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.18.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.4.0",
    "zcashname-sdk": "0.12.0",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/big.js": "6.2.2",
    "@types/chrome": "0.0.268",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-plugin-zip-pack": "1.2.4"
  }
