{
  "name": "@noir-wallet/extension",
  "version": "2.0.0",
  "description": "Noir Wallet is a self-custodial crypto wallet designed to support privacy-preserving on-chain activity.",
  "type": "module",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "EXTENSION_DEV_SERVER=1 vite --config vite.config.ts",
    "dev:extension": "pnpm run dev",
    "build": "pnpm run type-check && vite build && node scripts/verify-build-surface.mjs",
    "build:testnet": "pnpm run type-check && NETWORK_MODE=testnet vite build && NETWORK_MODE=testnet node scripts/verify-build-surface.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/run-tests.mjs",
    "wallets:provision:evm": "node scripts/provision-evm-live-test-wallet.mjs",
    "wallets:provision:bitcoin": "node scripts/provision-bitcoin-live-test-wallet.mjs",
    "wallets:check": "node scripts/check-test-wallets.mjs",
    "icons:from-logo": "node scripts/generate-icons-from-logo.mjs"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "@iconify/react": "6.0.2",
    "@keystonehq/bc-ur-registry": "0.7.1",
    "@keystonehq/bc-ur-registry-zcash": "0.1.2",
    "@ledgerhq/context-module": "2.6.0",
    "@ledgerhq/device-management-kit": "1.11.0",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.1",
    "@ledgerhq/device-signer-kit-bitcoin": "1.3.3",
    "@ledgerhq/device-signer-kit-solana": "1.13.3",
    "@ledgerhq/device-signer-kit-zcash": "0.7.1",
    "@ledgerhq/device-transport-kit-web-ble": "1.3.2",
    "@ledgerhq/device-transport-kit-web-hid": "1.2.4",
    "@ngraveio/bc-ur": "1.1.13",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@rhea-finance/cross-chain-aggregation-dex": "2.0.6",
    "@rhea-finance/cross-chain-sdk": "0.1.22",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@solana/web3.js": "1.99.0",
    "big.js": "7.0.1",
    "bitcoinjs-lib": "6.1.7",
    "bs58check": "3.0.1",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "jsqr": "1.4.0",
    "near-api-js": "5.1.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.18.3",
    "readable-stream": "2.3.8",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.4.0",
    "util": "0.12.5",
