# No environment file is required for the default local development commands.
# Build modes are selected by package scripts; see README.md.

# Optional website repository target for GitHub links and /github, /beta, /beta/versions redirects.
# Use a GitHub owner/repo; the default is NoirWallet/noir-wallet.
# WALLET_REPOSITORY=

# Production mainnet builds require these process environment variables.
# Supply them through CI secrets or your shell; do not commit real values.
# GA_API_SECRET=
# CUSTOM_ANALYTICS_PASSWORD=
