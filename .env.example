# Extension local development
# Copy to packages/extension/.env.local and replace the placeholder with a development token.
# This ignored file is read only by development builds.
RHEA_SWAP_ACCESS_TOKEN=replace-with-development-token

# Release builds read process environment variables, not the local file above.
# Configure RHEA_SWAP_ACCESS_TOKEN for beta and production builds.
# Production Mainnet also requires GA_API_SECRET and CUSTOM_ANALYTICS_PASSWORD.
# EVM_HISTORY_API_ORIGIN is an optional process environment override; omit it to use
# the bundled History proxy. See docs/release-workflow.md for release configuration.
